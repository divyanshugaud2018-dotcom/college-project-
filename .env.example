# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Gmail API OAuth settings for registration OTP emails.
# Enable Gmail API in Google Cloud and create OAuth credentials with the
# https://www.googleapis.com/auth/gmail.send scope. Keep real credentials in .env.local or deployment secrets.
GMAIL_CLIENT_ID="your_google_oauth_client_id"
GMAIL_CLIENT_SECRET="your_google_oauth_client_secret"
GMAIL_REFRESH_TOKEN="your_google_oauth_refresh_token"
GMAIL_SENDER="your_sender@gmail.com"
